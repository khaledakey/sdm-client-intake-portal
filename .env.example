# --- Database -----------------------------------------------------------
# Postgres connection string. In production (Railway) this is set to
# ${{Postgres.DATABASE_URL}}, referencing the Postgres service in the same
# project. For local dev, point at a local or hosted Postgres instance.
DATABASE_URL="postgresql://user:pass@localhost:5432/sdm_portal"

# --- Auth -----------------------------------------------------------------
# Random 32+ char secret used to sign session JWTs and password-reset tokens.
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# --- Local file storage ----------------------------------------------------
# Directory (relative to project root) where uploaded documents are stored.
# Swap the implementation in src/lib/storage.ts for S3 / GCS in production.
UPLOAD_DIR="./uploads"

# --- Email (configurable provider) -----------------------------------------
# EMAIL_PROVIDER = "console" | "smtp" | "webhook"
# "console"  -> emails are logged to stdout (default, safe for local dev)
# "smtp"     -> sent via nodemailer using the SMTP_* vars below
# "webhook"  -> POSTed as JSON to EMAIL_WEBHOOK_URL (e.g. a Make.com scenario
#               or Hostinger automation) which is responsible for delivery
EMAIL_PROVIDER="console"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SDM Client Portal <no-reply@saoirsedigital.com>"

EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# Mailbox that receives support ticket notifications for the SDM team.
SDM_SUPPORT_INBOX="info@saoirsedigital.com"

# --- Downstream integrations (Phase 6) -------------------------------------
# Optional Make.com (or other automation) webhook that receives structured
# integration events (new client, intake submitted, document uploaded,
# ticket created, onboarding stage changed) for syncing into the SDM CRM.
# Leave blank to disable — events are still recorded in the Activity Log.
INTEGRATION_WEBHOOK_URL=""
INTEGRATION_WEBHOOK_SECRET=""

# --- Public lead intake (/get-started) --------------------------------------
# Make.com webhook that receives the unauthenticated lead-capture form's
# submissions (event_type "client.registered", form_version "intake-v1").
# Points at the "Integration Webhooks, Notion" scenario, whose trigger's
# declared field list matches this form's payload field-for-field (search
# Organisation by Submission ID, search/dedupe Contact by Email, then
# create/update Org+Contact+Opportunity). Override only to point at a
# different scenario (e.g. a test one).
LEAD_INTAKE_WEBHOOK_URL="https://hook.eu1.make.com/jr5eedmxjodv2pfo66ixdtxbgpwx1ll6"
